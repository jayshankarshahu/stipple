{
    "manifest_version": 3,
    "name": "Stipple",
    "description": "A Notion-inspired dark mode note-taking extension with markdown, tags, and timeline view.",
    "version": "2.0.1",
    "action": {
        "default_popup": "index.html",
        "default_title": "Stipple"
    },
    "side_panel": {
        "default_path": "index.html",
        "default_title": "Stipple"
    },
    "permissions": [
        "storage",
        "sidePanel"
    ],
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}